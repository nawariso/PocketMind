# Copy this file to .env and replace every CHANGE_ME value before starting the stack.
POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
LITELLM_MASTER_KEY=CHANGE_ME_LITELLM_MASTER_KEY
LITELLM_SALT_KEY=CHANGE_ME_LITELLM_SALT_KEY
WEBUI_SECRET_KEY=CHANGE_ME_WEBUI_SECRET_KEY
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_OCR_MODEL=scb10x/typhoon-ocr1.5-3b
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_KEEP_ALIVE=10m
# Per-host tuning belongs in the private .env so repository updates preserve it.
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_FLASH_ATTENTION=false
OLLAMA_KV_CACHE_TYPE=f16
OLLAMA_SCHED_SPREAD=false
# NVIDIA profile: number of GPUs to reserve, or all. Applies to Ollama and the exporter.
NVIDIA_GPU_COUNT=1
# Docker CPU/NVIDIA backend listeners; Privacy mode always overrides these to loopback.
BACKEND_BIND_ADDRESS=0.0.0.0
# Ollama has no authentication: anyone who can reach this port bypasses API keys, limits and usage logging.
# Containers reach it over the internal network, so the host port is loopback by default. Change only for a trusted admin host.
OLLAMA_BIND_ADDRESS=127.0.0.1

# Prometheus keeps metrics until either limit is reached, whichever comes first.
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=10GB

# Optional image overrides. Keep these aligned with tested versions.
POSTGRES_IMAGE=postgres:16-alpine
OLLAMA_IMAGE=ollama/ollama:0.32.6
LITELLM_IMAGE=docker.litellm.ai/berriai/litellm-database:v1.96.0
# Open WebUI is pinned to the exact build this repository is tested with (version 0.11.4, linux/amd64 and linux/arm64).
# To move to another build: pull it, run the tests and the API Key Manager checks, then change this digest.
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui@sha256:8b432fe0a65b91116afc7961365c6cca5379cc923171386a96691f3471f3cae9
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0
GRAFANA_IMAGE=grafana/grafana:12.1.0
NVIDIA_GPU_EXPORTER_IMAGE=utkuozdemir/nvidia_gpu_exporter:1.13.1-nvml

# First administrator for Open WebUI. Set BOTH before the first start of a new installation: Open WebUI then
# creates this account and closes sign-up. Left empty, the first person who opens Open WebUI becomes the
# administrator, which is unsafe on a network. Use a long random password (at least 12 characters).
WEBUI_ADMIN_EMAIL=
WEBUI_ADMIN_PASSWORD=
WEBUI_ADMIN_NAME=Admin

# Role given to every other account that is created or signs in later. `user` approves them at once (no
# `pending` wait); use `pending` if an administrator should approve each one. Sign-up itself stays closed
# once the administrator exists, until an administrator turns it on in Admin Panel -> Settings -> General.
DEFAULT_USER_ROLE=user

# Optional shared-pilot proxy (nginx). Set PROXY_ENABLED=true to start it with the stack.
# It listens on every interface (0.0.0.0). Set PROXY_BIND_ADDRESS to the host's LAN IP to use one interface,
# or to 127.0.0.1 to keep it on this host only.
# Users open http://<host>:PROXY_WEBUI_PORT for Open WebUI and call http://<host>:PROXY_API_PORT/v1 for the API.
PROXY_ENABLED=false
PROXY_BIND_ADDRESS=0.0.0.0
PROXY_WEBUI_PORT=8480
PROXY_API_PORT=8481
NGINX_IMAGE=nginx:1.30-alpine

# Enable AFTER downloading approved models/images and preparing local RAG caches.
# Docker cpu/nvidia only; requires PROXY_ENABLED=true. See docs/privacy.md before enabling.
# False permits bootstrap downloads and is NOT network isolation.
PRIVACY_MODE=false
