{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": [],
      "title": "GPU Hardware (nvidia-smi)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Streaming multiprocessor utilization reported by NVIDIA.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "red", "value": 0.9 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        { "editorMode": "code", "expr": "nvidia_smi_utilization_gpu_ratio", "legendFormat": "{{name}}", "range": true, "refId": "A" }
      ],
      "title": "GPU SM Utilization",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Allocated and total dedicated GPU memory.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "min": 0,
          "unit": "bytes"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Total" }, "properties": [{ "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } }] }
        ]
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 3,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "editorMode": "code", "expr": "nvidia_smi_memory_used_bytes", "legendFormat": "Used", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "nvidia_smi_memory_total_bytes", "legendFormat": "Total", "range": true, "refId": "B" }
      ],
      "title": "VRAM Used / Total",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Current GPU board power draw.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-YlOrRd" },
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 45 }, { "color": "red", "value": 70 }] },
          "unit": "watt"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 4,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        { "editorMode": "code", "expr": "nvidia_smi_power_draw_watts", "legendFormat": "Power", "range": true, "refId": "A" }
      ],
      "title": "Power Draw",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "GPU core temperature reported by NVIDIA.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 85 }] },
          "unit": "celsius"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 9 },
      "id": 5,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        { "editorMode": "code", "expr": "nvidia_smi_temperature_gpu", "legendFormat": "Temperature", "range": true, "refId": "A" }
      ],
      "title": "GPU Temperature",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Current graphics/shader clock.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "min": 0,
          "unit": "hertz"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 9 },
      "id": 6,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        { "editorMode": "code", "expr": "nvidia_smi_clocks_current_graphics_clock_hz", "legendFormat": "Graphics clock", "range": true, "refId": "A" }
      ],
      "title": "Graphics Clock",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Fan percentage when the NVIDIA driver exposes it. The detected RTX 3050 Laptop GPU reports this field as N/A.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "max": 1,
          "min": 0,
          "noValue": "N/A - not exposed by this laptop GPU",
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 9 },
      "id": 7,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        { "editorMode": "code", "expr": "nvidia_smi_fan_speed_ratio", "legendFormat": "Fan", "range": true, "refId": "A" }
      ],
      "title": "Fan Speed",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "id": 8,
      "panels": [],
      "title": "Ollama / LiteLLM Engine",
      "type": "row"
    },
    {
      "description": "Ollama does not publish a vLLM-compatible KV-cache metric.",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 18 },
      "id": 9,
      "options": {
        "code": { "language": "plaintext", "showLineNumbers": false, "showMiniMap": false },
        "content": "## N/A\n\nOllama does not expose a Prometheus KV-cache usage gauge. This panel intentionally does not estimate or fabricate this value.",
        "mode": "markdown"
      },
      "pluginVersion": "12.1.0",
      "title": "KV Cache Usage",
      "type": "text"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Running requests are available from LiteLLM. A waiting-request count is unavailable; LiteLLM exposes queue latency instead of a waiting gauge.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "decimals": 0,
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 18 },
      "id": 10,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        { "editorMode": "code", "expr": "sum(litellm_in_flight_requests)", "legendFormat": "Running", "range": true, "refId": "A" }
      ],
      "title": "Requests Running / Waiting",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Input and generated tokens per second over a one-minute window.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "min": 0,
          "unit": "tps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 18 },
      "id": 11,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "editorMode": "code", "expr": "sum(rate(litellm_input_tokens_metric_total[1m]))", "legendFormat": "Input", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "sum(rate(litellm_output_tokens_metric_total[1m]))", "legendFormat": "Output", "range": true, "refId": "B" }
      ],
      "title": "Throughput (tokens/s)",
      "type": "timeseries"
    },
    {
      "description": "A truthful cache hit ratio requires both hit and query counters, which the current stack does not publish.",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 26 },
      "id": 12,
      "options": {
        "code": { "language": "plaintext", "showLineNumbers": false, "showMiniMap": false },
        "content": "## N/A\n\nThe current stack does not expose both cache hit and query counters, so a truthful prefix-cache hit rate cannot be calculated.",
        "mode": "markdown"
      },
      "pluginVersion": "12.1.0",
      "title": "Prefix Cache Hit Rate",
      "type": "text"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Median and p95 time until the first generated token, over a five-minute window.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "min": 0,
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 26 },
      "id": 13,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "editorMode": "code", "expr": "histogram_quantile(0.50, sum by (le) (rate(litellm_llm_api_time_to_first_token_metric_bucket[5m])))", "legendFormat": "p50", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le) (rate(litellm_llm_api_time_to_first_token_metric_bucket[5m])))", "legendFormat": "p95", "range": true, "refId": "B" }
      ],
      "title": "Time to First Token",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Median and p95 latency per generated output token, over a five-minute window.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "min": 0,
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 26 },
      "id": 14,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "editorMode": "code", "expr": "histogram_quantile(0.50, sum by (le) (rate(litellm_deployment_latency_per_output_token_bucket[5m])))", "legendFormat": "p50", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le) (rate(litellm_deployment_latency_per_output_token_bucket[5m])))", "legendFormat": "p95", "range": true, "refId": "B" }
      ],
      "title": "Inter-token Latency",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
